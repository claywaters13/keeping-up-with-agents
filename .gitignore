# ---------------------------------------------------------------------------
# PUBLISHING POSTURE: this repo ships the DERIVED layer only.
# Full verbatim transcripts and raw captions stay local as build substrate.
# Redistributing 231 talks verbatim is the one weak leg of the fair-use
# argument; excerpts + deep links back to YouTube cost almost no capability.
# Do not remove these rules without revisiting that decision.
# ---------------------------------------------------------------------------

# raw source: YouTube captions, per-video metadata, harvest logs (229MB)
raw/

# full verbatim transcripts (build substrate only)
data/transcripts/
data/livestream_segments/

# historical snapshots and superseded runs
data.bak-preglue-fix/
data/passA.bak-prefence-fix/
data/passA.stale-preglue-fix/
data/passA-medium-sample/
data/passA_segments/
pilot/

# run logs and per-item failure dumps
data/passC/_logs/
data/passC/_runlog.jsonl
data/concepts/assign/

# local scratch
*.pyc
__pycache__/
.DS_Store

# local-only working files, never published
posts/
HANDOFF.md
evals/results/
