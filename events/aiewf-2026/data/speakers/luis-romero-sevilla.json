    {
      "slug": "when-all-context-matters-extended-cache-augmented-generation",
      "title": "When All Context Matters: Extended Cache Augmented Generation",
      "url": "https://www.youtube.com/watch?v=XovaGv4f39A",
      "track": "",
      "day": null,
      "room": null,
