      "deep_link": "https://www.youtube.com/watch?v=IQkVMvXQKLY&t=211s",
      "speaker_attributed": true
    },
    {
      "claim": "Crosscoder / joint-feature interpretability on base and fine-tuned activations performs barely better than chance (~0.01 backdoor isolation score) at isolating backdoors.",
      "confidence": "stated",
      "timestamp_sec": 448,
      "talk_slug": "your-llm-deception-monitor-is-broken-the-fix-is-in-the-training-data",
      "deep_link": "https://www.youtube.com/watch?v=IQkVMvXQKLY&t=448s",
