  "positions": [
    {
      "claim": "The proliferation of provider-specific CLI coding agents created a need for a unified agent-client protocol, analogous to LSP for language tooling.",
      "confidence": "stated",
      "timestamp_sec": 14,
      "talk_slug": "building-an-acp-compatible-agent-live",
      "deep_link": "https://www.youtube.com/watch?v=HsxQICTLF84&t=14s",
      "speaker_attributed": true
    },
    {
      "claim": "ACP already has roughly 40 client implementations, including JetBrains, Obsidian, and open claw.",
      "confidence": "stated",
      "timestamp_sec": 54,
      "talk_slug": "building-an-acp-compatible-agent-live",
      "deep_link": "https://www.youtube.com/watch?v=HsxQICTLF84&t=54s",
      "speaker_attributed": true
    },
    {
      "claim": "A functional coding agent needs only two tools — read file and edit file — as its bare minimum.",
      "confidence": "stated",
      "timestamp_sec": 147,
      "talk_slug": "building-an-acp-compatible-agent-live",
      "deep_link": "https://www.youtube.com/watch?v=HsxQICTLF84&t=147s",
      "speaker_attributed": true
    },
    {
      "claim": "Because model APIs are stateless, every agent works the same way: resend the conversation, get a message or tool call, execute locally, loop.",
      "confidence": "stated",
      "timestamp_sec": 147,
      "talk_slug": "building-an-acp-compatible-agent-live",
      "deep_link": "https://www.youtube.com/watch?v=HsxQICTLF84&t=147s",
      "speaker_attributed": true
    },
    {
      "claim": "Making an existing agent ACP-compatible requires implementing only four functions and can be done in roughly 15 minutes.",
      "confidence": "stated",
      "timestamp_sec": 998,
      "talk_slug": "building-an-acp-compatible-agent-live",
      "deep_link": "https://www.youtube.com/watch?v=HsxQICTLF84&t=998s",
      "speaker_attributed": true
    },
    {
      "claim": "Agents should read files through ACP's proxied filesystem rather than native fs APIs, because the client may hold unsaved buffer state the agent needs to see.",
      "confidence": "stated",
      "timestamp_sec": 769,
      "talk_slug": "building-an-acp-compatible-agent-live",
      "deep_link": "https://www.youtube.com/watch?v=HsxQICTLF84&t=769s",
      "speaker_attributed": true
    },
    {
      "claim": "Diff rendering belongs on the client side: the agent sends only old text and new text, and the client computes and displays the diff.",
      "confidence": "stated",
      "timestamp_sec": 998,
      "talk_slug": "building-an-acp-compatible-agent-live",
      "deep_link": "https://www.youtube.com/watch?v=HsxQICTLF84&t=998s",
      "speaker_attributed": true
    },
    {
      "claim": "Letting the client own terminal creation and management, rather than the agent, is the better default because it adds interactivity to the editor UI.",
      "confidence": "implied",
      "timestamp_sec": 949,
      "talk_slug": "building-an-acp-compatible-agent-live",
      "deep_link": "https://www.youtube.com/watch?v=HsxQICTLF84&t=949s",
      "speaker_attributed": true
    },
    {
      "claim": "ACP currently only supports standard IO transport; remote transport is not yet available.",
