  "talks": [
    {
      "slug": "build-ai-systems-for-discernment-not-approval",
      "title": "Build AI Systems for Discernment, Not Approval",
      "url": "https://www.youtube.com/watch?v=CDqzWpwkSls",
      "track": "",
      "day": null,
      "room": null,
      "is_sole_speaker": true
