      "deep_link": "https://www.youtube.com/watch?v=JnubYCYunk8&t=54s",
      "speaker_attributed": true
    },
    {
      "claim": "A compressed markdown page representation costs roughly 1,800 tokens versus ~20,000 tokens for the full DOM on the same page.",
      "confidence": "stated",
      "timestamp_sec": 195,
      "talk_slug": "browser-agents-dont-need-better-models-they-need-better-eyes",
      "deep_link": "https://www.youtube.com/watch?v=JnubYCYunk8&t=195s",
      "speaker_attributed": true
    },
    {
