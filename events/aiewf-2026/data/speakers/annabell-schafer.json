  "positions": [
    {
      "claim": "Auto-improvement loops worked first in coding because compilation gives an unusually clear target function, not because loops generalize well.",
      "confidence": "stated",
      "timestamp_sec": 37,
      "talk_slug": "stop-burning-tokens-why-self-improvement-needs-domain-expertise-first",
      "deep_link": "https://www.youtube.com/watch?v=eAXxdtNlK04&t=37s",
      "speaker_attributed": true
    },
    {
      "claim": "Any target function given to an agent is always incomplete, so optimizing against it can head toward the wrong optimum.",
      "confidence": "stated",
      "timestamp_sec": 70,
      "talk_slug": "stop-burning-tokens-why-self-improvement-needs-domain-expertise-first",
      "deep_link": "https://www.youtube.com/watch?v=eAXxdtNlK04&t=70s",
      "speaker_attributed": true
    },
    {
      "claim": "Teams that invest in capturing their target function and building good evaluators are the ones that continuously improve their applications and ship with confidence.",
      "confidence": "stated",
      "timestamp_sec": 118,
      "talk_slug": "stop-burning-tokens-why-self-improvement-needs-domain-expertise-first",
      "deep_link": "https://www.youtube.com/watch?v=eAXxdtNlK04&t=118s",
      "speaker_attributed": true
    },
    {
      "claim": "A single-label classification task with ground-truth labels is the clearest-cut target function available for testing auto-optimization.",
      "confidence": "stated",
      "timestamp_sec": 156,
      "talk_slug": "stop-burning-tokens-why-self-improvement-needs-domain-expertise-first",
      "deep_link": "https://www.youtube.com/watch?v=eAXxdtNlK04&t=156s",
      "speaker_attributed": true
    },
    {
      "claim": "The prompt optimization loop improved accuracy from 68% to about 83% on fit/validate and 80.2% on a 300-item unseen test set.",
      "confidence": "stated",
      "timestamp_sec": 470,
      "talk_slug": "stop-burning-tokens-why-self-improvement-needs-domain-expertise-first",
      "deep_link": "https://www.youtube.com/watch?v=eAXxdtNlK04&t=470s",
      "speaker_attributed": true
    },
    {
      "claim": "Most of the gain from a self-improvement loop comes from the first iteration when the failure signal is clear; you could have stopped there.",
      "confidence": "stated",
      "timestamp_sec": 684,
      "talk_slug": "stop-burning-tokens-why-self-improvement-needs-domain-expertise-first",
      "deep_link": "https://www.youtube.com/watch?v=eAXxdtNlK04&t=684s",
      "speaker_attributed": true
    },
    {
      "claim": "Almost no real-world application has deterministic yes/no target functions, and LLM-as-a-judge evaluators return different answers across runs.",
      "confidence": "stated",
      "timestamp_sec": 684,
      "talk_slug": "stop-burning-tokens-why-self-improvement-needs-domain-expertise-first",
      "deep_link": "https://www.youtube.com/watch?v=eAXxdtNlK04&t=684s",
      "speaker_attributed": true
    },
    {
      "claim": "Generic evaluators like correctness, helpfulness, and hallucination scored on a 0-1 or 1-5 scale are low-signal for auto-improvement because the levels are almost never defined.",
      "confidence": "stated",
      "timestamp_sec": 732,
      "talk_slug": "stop-burning-tokens-why-self-improvement-needs-domain-expertise-first",
      "deep_link": "https://www.youtube.com/watch?v=eAXxdtNlK04&t=732s",
      "speaker_attributed": true
    },
    {
      "claim": "Binary, domain-specific checks (groundedness in retrieved context, brand-name correctness, categorization into known failure modes) are the right substitute for scalar quality scores.",
      "confidence": "stated",
      "timestamp_sec": 771,
      "talk_slug": "stop-burning-tokens-why-self-improvement-needs-domain-expertise-first",
      "deep_link": "https://www.youtube.com/watch?v=eAXxdtNlK04&t=771s",
      "speaker_attributed": true
    },
    {
      "claim": "Roughly a few hundred labeled examples were enough to produce high-signal feedback, though the needed volume depends on application complexity.",
      "confidence": "stated",
      "timestamp_sec": 862,
      "talk_slug": "stop-burning-tokens-why-self-improvement-needs-domain-expertise-first",
      "deep_link": "https://www.youtube.com/watch?v=eAXxdtNlK04&t=862s",
      "speaker_attributed": true
    },
    {
      "claim": "Domain experts should be used to create concrete examples and surface implicit decision criteria, which then become the high-signal evaluators.",
      "confidence": "stated",
      "timestamp_sec": 900,
      "talk_slug": "stop-burning-tokens-why-self-improvement-needs-domain-expertise-first",
      "deep_link": "https://www.youtube.com/watch?v=eAXxdtNlK04&t=900s",
      "speaker_attributed": true
    },
    {
      "claim": "Production data must be reviewed by humans, not only by coding agents, because failure modes and usage shift over time.",
      "confidence": "stated",
      "timestamp_sec": 949,
      "talk_slug": "stop-burning-tokens-why-self-improvement-needs-domain-expertise-first",
      "deep_link": "https://www.youtube.com/watch?v=eAXxdtNlK04&t=949s",
      "speaker_attributed": true
    },
    {
      "claim": "Optimization loops need traditional-ML validation mechanisms plus an explicit escape hatch to avoid burning tokens against a plateau.",
      "confidence": "stated",
      "timestamp_sec": 983,
      "talk_slug": "stop-burning-tokens-why-self-improvement-needs-domain-expertise-first",
      "deep_link": "https://www.youtube.com/watch?v=eAXxdtNlK04&t=983s",
      "speaker_attributed": true
    },
    {
      "claim": "Noise in the ground-truth labels themselves (authors' creative freedom in choosing arXiv categories) caps how high accuracy can go, so plateaus are not purely a model failure.",
      "confidence": "implied",
      "timestamp_sec": 432,
      "talk_slug": "stop-burning-tokens-why-self-improvement-needs-domain-expertise-first",
      "deep_link": "https://www.youtube.com/watch?v=eAXxdtNlK04&t=432s",
      "speaker_attributed": true
    }
