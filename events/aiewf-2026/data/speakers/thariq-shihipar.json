  "positions": [
    {
      "claim": "Model capability is limited primarily by the harness and prompting around it, not by the model's underlying knowledge.",
      "confidence": "stated",
      "timestamp_sec": 149,
      "talk_slug": "field-guide-to-fable",
      "deep_link": "https://www.youtube.com/watch?v=9fubhllmsBU&t=149s",
      "speaker_attributed": true
    },
    {
      "claim": "Giving a model tools to search and build its own context is a better path than scaling context windows to fit an entire codebase.",
      "confidence": "stated",
      "timestamp_sec": 314,
      "talk_slug": "field-guide-to-fable",
      "deep_link": "https://www.youtube.com/watch?v=9fubhllmsBU&t=314s",
      "speaker_attributed": true
    },
    {
      "claim": "The newest class of models performs better with a smaller system prompt, because in-prompt examples constrain a model that is more imaginative than the examples.",
      "confidence": "stated",
      "timestamp_sec": 386,
      "talk_slug": "field-guide-to-fable",
      "deep_link": "https://www.youtube.com/watch?v=9fubhllmsBU&t=386s",
      "speaker_attributed": true
    },
    {
      "claim": "Anthropic removed 80% of the Claude Code system prompt.",
      "confidence": "stated",
      "timestamp_sec": 347,
      "talk_slug": "field-guide-to-fable",
      "deep_link": "https://www.youtube.com/watch?v=9fubhllmsBU&t=347s",
      "speaker_attributed": true
    },
    {
      "claim": "Negative instructions ('do not do this'), which were necessary for previous models, should be replaced with context for current models.",
      "confidence": "stated",
      "timestamp_sec": 386,
      "talk_slug": "field-guide-to-fable",
      "deep_link": "https://www.youtube.com/watch?v=9fubhllmsBU&t=386s",
      "speaker_attributed": true
    },
    {
      "claim": "Understanding model behavior is an empirical, biology-like discipline rather than a physics-like one with known rules.",
      "confidence": "stated",
      "timestamp_sec": 499,
      "talk_slug": "field-guide-to-fable",
      "deep_link": "https://www.youtube.com/watch?v=9fubhllmsBU&t=499s",
      "speaker_attributed": true
    },
    {
      "claim": "More capable models increase rather than decrease the need for upfront specification, because they cover more territory and hit more unspecified decision points.",
      "confidence": "stated",
      "timestamp_sec": 577,
      "talk_slug": "field-guide-to-fable",
      "deep_link": "https://www.youtube.com/watch?v=9fubhllmsBU&t=577s",
      "speaker_attributed": true
    },
    {
      "claim": "The human's bottleneck when working with Fable is their own ability to match map to territory and identify unknowns.",
      "confidence": "stated",
      "timestamp_sec": 577,
      "talk_slug": "field-guide-to-fable",
      "deep_link": "https://www.youtube.com/watch?v=9fubhllmsBU&t=577s",
      "speaker_attributed": true
    },
    {
      "claim": "Passing existing code or an HTML mockup as a reference is more effective than writing out a spec in prose.",
      "confidence": "stated",
      "timestamp_sec": 757,
      "talk_slug": "field-guide-to-fable",
      "deep_link": "https://www.youtube.com/watch?v=9fubhllmsBU&t=757s",
      "speaker_attributed": true
    },
    {
      "claim": "Claude Tag's unlock was the model's ability to work proactively and in multiplayer, which is what enables the next wave of agents.",
      "confidence": "stated",
      "timestamp_sec": 314,
      "talk_slug": "field-guide-to-fable",
      "deep_link": "https://www.youtube.com/watch?v=9fubhllmsBU&t=314s",
      "speaker_attributed": true
    },
    {
      "claim": "Many product tradeoffs previously imposed by the cost of writing code are no longer real and should be tested rather than assumed.",
      "confidence": "stated",
      "timestamp_sec": 980,
      "talk_slug": "field-guide-to-fable",
      "deep_link": "https://www.youtube.com/watch?v=9fubhllmsBU&t=980s",
      "speaker_attributed": true
    },
    {
      "claim": "The burden of proof that AI agents work rests on AI engineers producing their best work faster, not on benchmarks or claims.",
