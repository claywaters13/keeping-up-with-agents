      "deep_link": "https://www.youtube.com/watch?v=ZRM_TfEZcIo&t=1499s",
      "speaker_attributed": true
    },
    {
      "claim": "A knowledge base should update from questions asked of it, not only from ingestion events.",
      "confidence": "stated",
