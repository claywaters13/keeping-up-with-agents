      "confidence": "stated",
      "timestamp_sec": 1144,
      "talk_slug": "turn-10994-notes-into-memory",
      "deep_link": "https://www.youtube.com/watch?v=ZRM_TfEZcIo&t=1144s",
      "speaker_attributed": true
    },
    {
      "claim": "The limiting factor in agentic research is not how much context you can supply but whether it persists across sessions.",
      "confidence": "stated",
      "timestamp_sec": 516,
      "talk_slug": "turn-10994-notes-into-memory",
      "deep_link": "https://www.youtube.com/watch?v=ZRM_TfEZcIo&t=516s",
      "speaker_attributed": true
    },
    {
