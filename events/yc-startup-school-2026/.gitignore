# ---------------------------------------------------------------------------
# PUBLISHING POSTURE: this repo ships the DERIVED layer only.
# Full verbatim transcripts and raw captions stay local as build substrate.
# Redistributing 14 talks verbatim is the one weak leg of the fair-use
# argument; excerpts + deep links back to YouTube cost almost no capability.
# Do not remove these rules without revisiting that decision.
# ---------------------------------------------------------------------------

# raw source: YouTube captions, per-video metadata, playlist manifests, harvest logs
raw/

# full verbatim transcripts (build substrate only)
data/transcripts/

# run logs and per-item failure dumps
data/passA/_logs/
data/passC/_logs/
data/passC/_runlog.jsonl
data/concepts/assign/

# local scratch
*.pyc
__pycache__/
.DS_Store
